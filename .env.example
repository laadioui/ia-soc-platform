# =============================================================================
# AI SOC Platform — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to Git.
# =============================================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
APP_NAME=ai-soc-platform

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aisoc
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=aisoc
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- OpenSearch ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme_opensearch_password
OPENSEARCH_URL=https://${OPENSEARCH_USER}:${OPENSEARCH_PASSWORD}@${OPENSEARCH_HOST}:${OPENSEARCH_PORT}

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-soc
KEYCLOAK_CLIENT_ID=ai-soc-platform
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin_password

# --- JWT ---
JWT_SECRET_KEY=changeme_jwt_secret_key_min_32_chars
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API Gateway ---
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- AI / LLM ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=ai-soc
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ai-soc-frontend

# --- Notification ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ai-soc-platform.local
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Prometheus / Grafana ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# --- SOAR ---
SOAR_SIMULATION_MODE=true
SOAR_APPROVAL_REQUIRED=true

# --- Rate Limiting ---
RATE_LIMIT_EVENTS_PER_MINUTE=1000
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AI_PER_MINUTE=30
